@model UserIdentity.Models.Register
@{
    ViewBag.Title = "Register";
}

<h2>Register</h2>
<hr /> @Html.ValidationSummary() @using (Html.BeginForm())
{@Html.AntiForgeryToken()

<div class="container mt-3">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="mb-3">
                <label for="UserName" class="form-label">User Name</label>
                @Html.TextBoxFor(i => i.UserName, new { @class = "form-control", id = "UserName" })
            </div>

            <div class="mb-3">
                <label for="Email" class="form-label">Email address</label>
                @Html.TextBoxFor(i => i.Email, new { @class = "form-control", id = "Email", type = "email" })
                <div id="emailHelp" class="form-text"></div>
            </div>

            <div class="mb-3">
                <label for="Password" class="form-label">Password</label>
                @Html.PasswordFor(i => i.Password, new { @class = "form-control", id = "Password" })
            </div>

            <button type="submit" class="btn btn-primary w-100">Save</button>

        </div>
    </div>
</div>
}