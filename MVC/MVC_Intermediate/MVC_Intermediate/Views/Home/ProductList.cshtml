@model List<MVC_Intermediate.Models.Product>
@{
    ViewBag.Title = "ProductList";
}

<h2>Product List</h2>
<hr />

<table class="table table-bordered">
    
    <thead>
    <tr>
        <th>Product İmage</th>
        <th>Product Name</th>
        <th>Product Price</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
      

    

    @foreach (var item in Model)
    {
        <tr>
            <td>
                <img src="~/img/@item.ProductImage" />
            </td>
            <td>@item.ProductName</td>
            <td>@item.ProductPrice</td>
            <td>
                <a href="/Home/Details/@item.ProductId" class="btn btn-primary btn-xs">Detail</a>
            </td>
        </tr>
    }

    </tbody>

</table>