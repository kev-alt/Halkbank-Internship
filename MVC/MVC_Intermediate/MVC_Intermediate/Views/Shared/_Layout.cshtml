<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Product Catalog</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/Content/Site.css" rel="stylesheet" />
    <style>
        .sidebar {
            position: sticky;
            top: 70px;
            height: calc(100vh - 80px);
            overflow-y: auto;
            border-right: 1px solid #dee2e6;
            padding-top: 1rem;
        }

        .category-link {
            border-radius: 0.25rem;
            transition: all 0.2s;
            margin-bottom: 0.25rem;
        }

            .category-link:hover,
            .category-link.active {
                background-color: #e9f7fe;
                color: #0d6efd;
                transform: translateX(3px);
            }

        .main-content {
            padding-top: 1rem;
        }

        .navbar-brand {
            font-weight: 600;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">Product Catalog</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="#">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Contact</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

<div class="container-fluid" style="margin-top: 70px;">
    @if (IsSectionDefined("Category"))
    {
        <div class="row">
            <div class="col-lg-2 d-none d-lg-block sidebar">
                @RenderSection("Category", false)
            </div>

            <div class="col-lg-10 main-content">
                @RenderBody()
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-12">
                <div class="text-center">
                    @RenderBody()
                </div>
            </div>
        </div>

    }

</div>

    <footer class="border-top mt-5 py-3 bg-light">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-6">
                    <h5>Product Catalog</h5>
                    <p class="text-muted">Your one-stop shop for quality products</p>
                </div>
                <div class="col-md-3">
                    <h6>Quick Links</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-decoration-none text-muted">Home</a></li>
                        <li><a href="#" class="text-decoration-none text-muted">Products</a></li>
                        <li><a href="#" class="text-decoration-none text-muted">Categories</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6>Contact</h6>
                    <ul class="list-unstyled">
                        <li class="text-muted">contact@example.com</li>
                        <li class="text-muted">+1 (123) 456-7890</li>
                    </ul>
                </div>
            </div>
            <p class="text-center text-muted mt-3">&copy; @DateTime.Now.Year - Product Catalog. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>